# Copy this file to .env.local for local-only settings.
# Never commit the copied file or real keys.
OPENROUTER_API_KEYS=key-one,key-two,key-three
OPENROUTER_MODELS=openai/gpt-4o-mini,google/gemini-2.0-flash,openai/gpt-4o-mini
OPENROUTER_ALLOW_GROUNDED_DATA=1
OPENROUTER_TIMEOUT_SECONDS=20
OWNER_PASSWORD=choose-a-local-owner-password
