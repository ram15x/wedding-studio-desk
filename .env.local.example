# Local family desk password. Change this before running the app.
OWNER_PASSWORD=choose-a-private-family-password

# Optional local overrides:
# ASSIGNMENT_HOST=127.0.0.1
# ASSIGNMENT_PORT=8787
# ASSIGNMENT_DB_PATH=assignment.db

# Optional: guest-message intent parsing only. Do not commit real keys.
# OPENROUTER_API_KEYS=<key-1>,<key-2>,<key-3>
# OPENROUTER_MODELS=<model-1>,<model-2>,<model-3>
# OPENROUTER_TIMEOUT_SECONDS=20
